# Copiar a .env.local y reemplazar con valores reales (nunca commitear .env.local)

# Google Apps Script — Web App URL
# VITE_SHEET_URL=https://script.google.com/macros/s/XXXX/exec

# Gemini API Key — Google AI Studio
# VITE_GEMINI_API_KEY=AIzaSy...

# Google Drive — IDs de carpetas (segmento de drive.google.com/drive/folders/ID)
# VITE_DRIVE_FOLDER_REMITOS=
# VITE_DRIVE_FOLDER_FACTURAS=
# VITE_DRIVE_FOLDER_DOCUMENTOS=

# Deprecated / ignored in production builds. DEV mock activates automatically when VITE_SHEET_URL is unset.
# VITE_ALLOW_MOCK=true

# clasp 3.x — existing Web App deployment ID only (Manage deployments). Required for npm run gas:deploy.
# Never create a new deployment; update-deployment keeps the same /exec URL.
# GAS_DEPLOYMENT_ID=
# Explicit HITL confirm for gas:deploy (must be 1 after human OK). Do not leave set in casual shells.
# CONFIRM_GAS_DEPLOY=
